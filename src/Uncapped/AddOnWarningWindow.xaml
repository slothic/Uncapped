<Window x:Class="Uncapped.AddOnWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Addons we did not install"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#12080C" Foreground="#E8DFEA"
        FontFamily="Segoe UI" FontSize="13">

    <StackPanel Margin="22">

        <TextBlock Text="You have addons we did not install"
                   FontSize="17" FontWeight="SemiBold" Foreground="#F0E6F2"
                   TextWrapping="Wrap" Margin="0,0,0,12" />

        <TextBlock TextWrapping="Wrap" Foreground="#C9BDCC" Margin="0,0,0,12">
            These are yours, and we have left them alone. They may still work perfectly well —
            but this realm changes a lot that ordinary addons assume, so if you see Lua errors
            or something behaving oddly, one of these is the first thing to switch off.
        </TextBlock>

        <Border Background="#1B1016" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AddOnList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#E8DFEA" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <CheckBox x:Name="DontAskAgain" Foreground="#C9BDCC" Margin="0,0,0,16">
            <TextBlock Text="I have read this warning and don't want to see it again"
                       TextWrapping="Wrap" Foreground="#C9BDCC" />
        </CheckBox>

        <Button x:Name="OkButton" Content="OK" Width="110" Height="32"
                HorizontalAlignment="Right" IsDefault="True" Click="OnOk" />
    </StackPanel>
</Window>
