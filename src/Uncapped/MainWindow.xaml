<Window x:Class="Uncapped.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uncapped Launcher"
        Width="1160" Height="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI">

    <!-- Outer margin leaves room for the drop shadow to fall outside the window body. -->
    <Border Margin="14" CornerRadius="12" Background="#12080C">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="0.62" Color="#000000" />
        </Border.Effect>

        <!-- Clips the artwork to the rounded corners. -->
        <Border CornerRadius="12" ClipToBounds="True">
            <Grid>

                <Image Source="Assets/background.jpg" Stretch="UniformToFill" />

                <!-- Drag anywhere on the art, since there is no title bar to grab. -->
                <Rectangle Fill="Transparent" MouseLeftButtonDown="OnDragWindow" />

                <!-- ── Window controls ─────────────────────────────────────────── -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,10,12,0">
                    <Button Style="{StaticResource ChromeButton}"
                            Content="&#xE921;" ToolTip="Minimise" Click="OnMinimize" />
                    <Button Style="{StaticResource ChromeButton}"
                            Content="&#xE8BB;" ToolTip="Close" Click="OnClose" />
                </StackPanel>

                <!-- ── Build stamp ─────────────────────────────────────────────────
                     Bottom left, quiet and out of the way. Worth having on screen: the
                     first question about any launcher problem is which build it is, and
                     until now the only way to answer was to dig through launcher.log.
                     Read from the assembly rather than typed in, so it cannot drift from
                     the version that was actually shipped. Named LauncherVersionText
                     because VersionText is already the CLIENT build readout on the right;
                     two different numbers that are easy to confuse. -->
                <TextBlock x:Name="LauncherVersionText" FontSize="11"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom"
                           Margin="26,0,0,18" Foreground="#8A7F92"
                           IsHitTestVisible="False">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.9" Color="#1A0A14" />
                    </TextBlock.Effect>
                </TextBlock>

                <!-- ── Wordmark ────────────────────────────────────────────────────
                     Top right, tucked under the window controls: it is branding, not part of
                     the launch flow, and sitting above PLAY it was only pushing the thing
                     people actually came for further down the screen. -->
                <TextBlock Text="UNCAPPED" FontSize="36" FontWeight="Light"
                           HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,44,44,0" Foreground="{StaticResource Ink}"
                           IsHitTestVisible="False">
                    <!-- A soft glow keeps it legible wherever the sky behind is bright. -->
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.9" Color="#1A0A14" />
                    </TextBlock.Effect>
                </TextBlock>

                <!-- ── Donate ──────────────────────────────────────────────────────
                     The right column's upper half, which the news frame below was laid out
                     to leave free for exactly this. Clear of the wordmark above and a long
                     way from PLAY at the bottom, so it is never what a player hits on the
                     way to launching the game.

                     Hidden unless the manifest carries a donateUrl — same pattern as
                     RegisterLink further down. That also keeps the address out of the
                     binary: it has already moved once (PayPal to Ko-fi), and a URL
                     compiled in would have made that a launcher release.

                     The caption is not decoration. "Donations buy nothing in-game" is the
                     project's standing position, stated in #donations and on the landing
                     page, and a button in the launcher is the single most likely place for
                     a player to assume the opposite. -->
                <StackPanel x:Name="DonatePanel" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,116,44,0" Width="300" Visibility="Collapsed">
                    <Button x:Name="DonateButton" Style="{StaticResource GhostButton}"
                            Content="SUPPORT THE SERVER" Height="34" Click="OnDonate" />
                    <!-- Brighter than the build stamp it was first matched to. That one sits
                         bottom-left over dark water and can afford to disappear; this sits
                         over the brightest part of the sky, and it is the line that keeps
                         the button from reading as a shop. -->
                    <TextBlock Text="Voluntary. Buys nothing in-game." FontSize="10.5"
                               Margin="0,7,0,0" HorizontalAlignment="Right" TextAlignment="Right"
                               Foreground="#CFC5D2" IsHitTestVisible="False">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.9" Color="#1A0A14" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- ── News frame ──────────────────────────────────────────────────
                     Full height down the left. The right column's upper half is the donate
                     panel above; keeping this one to the left is what leaves that space. -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        Margin="40,40,0,40" Width="600" CornerRadius="14"
                        BorderThickness="1" BorderBrush="#2EFFFFFF">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                            <GradientStop Offset="0" Color="#D41A1220" />
                            <GradientStop Offset="1" Color="#C8120B18" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.5" Color="#000000" />
                    </Border.Effect>

                    <Grid Margin="22,18,20,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="NEWS" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#8E8394" Margin="2,0,0,12" />

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="232" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Master: every entry, scrollable -->
                            <ListBox x:Name="NewsList" Grid.Column="0"
                                     Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource NewsItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionChanged="OnNewsSelected">
                                <ListBox.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                                </ListBox.Resources>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Date}" FontSize="10" Foreground="#7E7386" />
                                            <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#DCD4DE"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Detail: the selected entry in full -->
                            <Border Grid.Column="1" Margin="18,0,0,0" Padding="18,2,0,0"
                                    BorderThickness="1,0,0,0" BorderBrush="#1FFFFFFF">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                                    </ScrollViewer.Resources>
                                    <StackPanel>
                                        <TextBlock x:Name="DetailDate" FontSize="10.5" Foreground="#8E8394" />
                                        <TextBlock x:Name="DetailTitle" FontSize="16" Margin="0,4,0,0"
                                                   Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="DetailBody" FontSize="12.5" Margin="0,10,0,0"
                                                   Foreground="#BDB2C0" TextWrapping="Wrap" LineHeight="19" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ── Status and PLAY ─────────────────────────────────────────── -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,44,44" Width="300">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" IsHitTestVisible="False">
                        <Ellipse x:Name="RealmDot" Width="7" Height="7" Fill="{StaticResource Muted}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="RealmText" Text="Checking realm…" Margin="8,0,0,0"
                                   FontSize="11.5" Foreground="#D3C9D6" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.9" Color="#1A0A14" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>

                    <!-- Which client build the player is on, read from the version addon the
                         server's gate actually checks. -->
                    <TextBlock x:Name="VersionText" FontSize="11" Margin="0,6,0,0"
                               HorizontalAlignment="Right" TextAlignment="Right"
                               Foreground="{StaticResource Muted}" IsHitTestVisible="False">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.9" Color="#1A0A14" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Transient: whatever the launcher is doing this second. -->
                    <TextBlock x:Name="StatusText" Text="Starting…" FontSize="11.5" Margin="0,9,0,0"
                               HorizontalAlignment="Right" TextAlignment="Right" Foreground="#BCB0BE"
                               TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.9" Color="#1A0A14" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <ProgressBar x:Name="Progress" Style="{StaticResource SlimProgress}"
                                 Minimum="0" Maximum="1000" Value="0" Margin="0,10,0,0" />

                    <!-- Sticky: what the last update actually did. Kept separate from the line
                         above so that launching the game — "Running." — does not wipe out the
                         one piece of text that says what changed. -->
                    <TextBlock x:Name="SummaryText" FontSize="11.5" Margin="0,9,0,0"
                               HorizontalAlignment="Right" TextAlignment="Right" Foreground="#D8CFDA"
                               TextWrapping="Wrap" IsHitTestVisible="False">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.9" Color="#1A0A14" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <Button x:Name="PlayButton" Style="{StaticResource PlayButton}"
                            Content="PLAY" Height="66" Margin="0,14,0,0"
                            IsEnabled="False" Click="OnPlay" />

                    <Button x:Name="CheckButton" Style="{StaticResource GhostButton}"
                            Content="CHECK FOR UPDATES" Height="32" Margin="0,8,0,0"
                            IsEnabled="False" Click="OnCheckForUpdates" />

                    <!-- Only shown when the client actually needs it. A permanently visible
                         REPAIR button invites people to press it on a healthy install and
                         re-download 4 GB for nothing. -->
                    <Button x:Name="RepairButton" Style="{StaticResource GhostButton}"
                            Content="REPAIR CLIENT" Height="32" Margin="0,8,0,0"
                            Visibility="Collapsed" Click="OnRepair" />

                    <!-- A WrapPanel rather than a StackPanel: four links do not fit on one
                         300px line, and a horizontal StackPanel would silently clip the last
                         one instead of moving it down. -->
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="RegisterLink" Style="{StaticResource QuietLink}"
                                Content="Create an account" Visibility="Collapsed" Click="OnRegister" />
                        <TextBlock x:Name="LinkSeparator" Text="  ·  " Foreground="#5A5060" FontSize="11"
                                   Visibility="Collapsed" />
                        <Button x:Name="LoginLink" Style="{StaticResource QuietLink}"
                                Content="Saved login" Click="OnSavedLogin" />
                        <TextBlock Text="  ·  " Foreground="#5A5060" FontSize="11" />
                        <Button Style="{StaticResource QuietLink}"
                                Content="Change game folder" Click="OnChangeFolder" />
                        <TextBlock Text="  ·  " Foreground="#5A5060" FontSize="11" />
                        <!-- Every support conversation used to start by talking someone
                             through %LOCALAPPDATA%. The launcher knows where the file is. -->
                        <Button Style="{StaticResource QuietLink}"
                                Content="Open log" Click="OnOpenLog" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
