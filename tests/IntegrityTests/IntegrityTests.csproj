<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A console harness for IntegrityVerifier, not a unit-test framework run.

    It compiles the verifier and its dependencies directly out of the launcher project
    rather than referencing it: the launcher is a WPF app targeting net9.0-windows and
    pulling it in whole would drag the UI, WinForms and the App entry point into a
    console process for no benefit. The files listed below are the entire dependency
    closure of the thing under test.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Uncapped.Tests</RootNamespace>
    <AssemblyName>IntegrityTests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mirrors the launcher's own <Using> block. The services under test rely on these
         being global; without them every file fails on FileInfo and HttpClient. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- The warning dialog, so the harness can render it. New XAML that nothing else
         exercises, and the binding names inside a DataTemplate only fail at runtime. -->
    <Page Include="..\..\src\Uncapped\IntegrityWarningWindow.xaml">
      <Link>IntegrityWarningWindow.xaml</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="..\..\src\Uncapped\IntegrityWarningWindow.xaml.cs">
      <Link>IntegrityWarningWindow.xaml.cs</Link>
      <DependentUpon>IntegrityWarningWindow.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />

    <Compile Include="..\..\src\Uncapped\Model\Baseline.cs" />
    <Compile Include="..\..\src\Uncapped\Model\Manifest.cs" />
    <Compile Include="..\..\src\Uncapped\Model\LauncherState.cs" />
    <Compile Include="..\..\src\Uncapped\Services\IntegrityVerifier.cs" />
    <Compile Include="..\..\src\Uncapped\Services\RepairService.cs" />
    <Compile Include="..\..\src\Uncapped\Services\SyncService.cs" />
    <Compile Include="..\..\src\Uncapped\Services\ClientLocale.cs" />
    <!-- The shared resume-and-retry download. RepairService and SyncService both call it, so
         it is part of their dependency closure even though the harness never downloads. -->
    <Compile Include="..\..\src\Uncapped\Services\ResilientDownload.cs" />
    <!-- The item cache: installed from the manifest, keyed on an epoch token. Every failure
         path is asserted to fall back to the old wipe, which is the safety net the owner
         chose in place of a server-side client-load gate. -->
    <Compile Include="..\..\src\Uncapped\Services\WdbCache.cs" />
    <!-- The client builder. Tested against the REAL base file and the REAL published patch
         list, because the failure it guards against is not a logic bug but a stale block:
         a patch list cut from a different base refuses on every player's machine at once. -->
    <Compile Include="..\..\src\Uncapped\Services\ClientPatcher.cs" />
    <Compile Include="..\..\src\Uncapped\Services\ClientExecutable.cs" />
    <Compile Include="..\..\src\Uncapped\Services\ConfigWtf.cs" />
    <!-- Uninstalling a retired addon, and the full factory reset behind REPAIR. These delete
         files a player did not ask us to touch, which is why they are tested here and not
         only exercised by hand: the guards are the feature. FirstRunConfigurator comes with
         them because it owns the one definition of "our stock settings", and ViewDistance
         because that definition reads its constant. -->
    <Compile Include="..\..\src\Uncapped\Services\AddOnRemover.cs" />
    <Compile Include="..\..\src\Uncapped\Services\FactoryReset.cs" />
    <Compile Include="..\..\src\Uncapped\Services\ForeignAddOnScanner.cs" />
    <Compile Include="..\..\src\Uncapped\Services\FirstRunConfigurator.cs" />
    <Compile Include="..\..\src\Uncapped\Services\ViewDistance.cs" />
    <!-- The weighted step plan behind the progress bar. Pure arithmetic, and the property
         worth pinning (it never goes backwards) is not one you can see by looking. -->
    <Compile Include="..\..\src\Uncapped\Services\WorkPlan.cs" />
    <Compile Include="..\..\src\Uncapped\Services\Hashing.cs" />
    <Compile Include="..\..\src\Uncapped\Logging.cs" />
    <Compile Include="..\..\src\Uncapped\AppPaths.cs" />
    <!-- Both were added to the launcher after this list was last touched, which broke the
         harness build: LauncherState.Save uses AtomicFile and SyncService uses SafePath.
         The closure has to be maintained by hand, so a missing entry shows up as CS0103
         rather than as a test failure. -->
    <Compile Include="..\..\src\Uncapped\AtomicFile.cs" />
    <Compile Include="..\..\src\Uncapped\Services\SafePath.cs" />
  </ItemGroup>

</Project>
